{
  "name": "refinedocs",
  "version": "1.0.0",
  "description": "100% Free, Client-Side, Open-Source Document & Media Processing Suite",
  "author": {
    "name": "Refinedocs",
    "email": "konwoubuntu@gmail.com"
  },
  "desktopName": "refinedocs.desktop",
  "license": "Apache-2.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:desktop": "concurrently \"next dev -p 3000\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "next build",
    "build:desktop:assets": "node scripts/copy-standalone-assets.js",
    "build:desktop": "next build && node scripts/copy-standalone-assets.js && electron-builder --publish never",
    "dist:mac": "next build && node scripts/copy-standalone-assets.js && electron-builder --mac --publish never",
    "dist:win": "next build && node scripts/copy-standalone-assets.js && electron-builder --win --publish never",
    "dist:linux": "next build && node scripts/copy-standalone-assets.js && electron-builder --linux --publish never",
    "dist:all": "next build && node scripts/copy-standalone-assets.js && electron-builder -mwl --publish never",
    "start": "next start -p 3000",
    "lint": "next lint"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.2",
    "@next/third-parties": "14.2.13",
    "clsx": "^2.1.1",
    "docx": "^9.0.3",
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "heic-to": "^1.1.0",
    "i18n-iso-countries": "^7.14.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.446.0",
    "mammoth": "^1.8.0",
    "motion": "^12.23.24",
    "next": "14.2.13",
    "next-intl": "^3.19.1",
    "next-themes": "^0.4.6",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "reading-time": "^1.5.0",
    "tailwind-merge": "^2.5.4",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.13",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "wait-on": "^9.5.1"
  }
}
